    <item>
        <shape android:shape="oval">
            <solid android:color="#FF00796B" />
        </shape>
    </item>
    <item
        android:left="-12dp"
        android:top="-12dp"
        android:right="-12dp"
        android:bottom="-12dp"
        android:drawable="@drawable/ic_brand_foreground" />
</layer-list>
