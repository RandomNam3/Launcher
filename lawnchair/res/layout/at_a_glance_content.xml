     Content of the "At a Glance" view on the first home screen page.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/glance_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/glance_clock"
            style="@style/AtAGlanceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_at_a_glance_item"
            android:textSize="@dimen/at_a_glance_clock_size"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/glance_title_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/glance_date"
                style="@style/AtAGlanceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_at_a_glance_item"
                android:textSize="@dimen/at_a_glance_title_size" />

            <TextView
                android:id="@+id/glance_title"
                style="@style/AtAGlanceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_at_a_glance_item"
                android:textSize="@dimen/at_a_glance_title_size"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/glance_title_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:background="@drawable/bg_at_a_glance_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/glance_title_weather_icon"
                    android:layout_width="@dimen/at_a_glance_title_icon_size"
                    android:layout_height="@dimen/at_a_glance_title_icon_size"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/glance_title_weather_text"
                    style="@style/AtAGlanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="@dimen/at_a_glance_title_size" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/glance_subtitle_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/glance_subtitle_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:background="@drawable/bg_at_a_glance_item"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/glance_subtitle_icon"
                    android:layout_width="@dimen/at_a_glance_subtitle_icon_size"
                    android:layout_height="@dimen/at_a_glance_subtitle_icon_size"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/glance_subtitle"
                    style="@style/AtAGlanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="@dimen/at_a_glance_subtitle_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/glance_subtitle_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:background="@drawable/bg_at_a_glance_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/glance_subtitle_weather_icon"
                    android:layout_width="@dimen/at_a_glance_subtitle_icon_size"
                    android:layout_height="@dimen/at_a_glance_subtitle_icon_size"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/glance_subtitle_weather_text"
                    style="@style/AtAGlanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="@dimen/at_a_glance_subtitle_size" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</merge>
